# Configuración de Correo Real (SMTP)
# Para usar tu cuenta de Gmail:
# 1. Ve a tu cuenta de Google > Seguridad > Verificación en 2 pasos.
# 2. Busca "Contraseñas de aplicaciones" (App Passwords) y genera una para "Correo".
# 3. Pega los datos aquí abajo y renombra este archivo como ".env"

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=tu_contraseña_de_aplicacion_de_16_letras
DEFAULT_FROM_EMAIL=Patrimonio Cerca <tu_correo@gmail.com>

# Clave secreta para producción (opcional en desarrollo)
DJANGO_SECRET_KEY=clave-secreta-produccion-12345
DJANGO_DEBUG=True
