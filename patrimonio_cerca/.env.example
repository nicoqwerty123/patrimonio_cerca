# ============================================================
# Correos con Brevo (recomendado, funciona en Render)
# ============================================================
# 1. Crea una cuenta gratuita en https://www.brevo.com (300 correos/dia).
# 2. En Brevo: SMTP & API -> API Keys -> Generar una nueva clave SMTP.
# 3. IMPORTANTE: en Brevo -> Security -> Authorised IPs, desactiva la
#    restriccion de IPs (o el servidor de Render sera rechazado con 401).
# 4. Verifica tu correo como remitente en Brevo -> Senders.
# 5. Copia estos valores a tu archivo ".env" local y, en produccion,
#    a las Environment Variables de Render.

BREVO_API_KEY=xkeysib-tu-clave-api-de-brevo
BREVO_SENDER_EMAIL=tu_correo@ejemplo.com

# Respaldo SMTP (opcional; los puertos SMTP suelen estar bloqueados en Render)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_usuario_smtp
EMAIL_HOST_PASSWORD=tu_clave_smtp
DEFAULT_FROM_EMAIL=Patrimonio Cerca <tu_correo@ejemplo.com>

# Clave secreta para producción (opcional en desarrollo)
DJANGO_SECRET_KEY=clave-secreta-produccion-12345
DJANGO_DEBUG=True
